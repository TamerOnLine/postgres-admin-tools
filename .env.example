# Copy this file to .env and replace every placeholder.

# Generate a strong value, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Option A: complete PostgreSQL connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Option B: individual PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-a-strong-password

# Disabled unless explicitly enabled
FLASK_DEBUG=false
